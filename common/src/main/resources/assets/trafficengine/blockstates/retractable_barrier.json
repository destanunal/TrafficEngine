{
  "multipart": [
    {
      "when": {
        "facing": "north",
        "folded": "false"
      },
      "apply": {
        "model": "trafficengine:block/retractable_barrier_core"
      }
    },
    {
      "when": {
        "facing": "east",
        "folded": "false"
      },
      "apply": {
        "model": "trafficengine:block/retractable_barrier_core",
        "y": 90
      }
    },
    {
      "when": {
        "facing": "south",
        "folded": "false"
      },
      "apply": {
        "model": "trafficengine:block/retractable_barrier_core",
        "y": 180
      }
    },
    {
      "when": {
        "facing": "west",
        "folded": "false"
      },
      "apply": {
        "model": "trafficengine:block/retractable_barrier_core",
        "y": 270
      }
    },
    {
      "when": {
        "facing": "north",
        "left_connected": "false",
        "folded": "false"
      },
      "apply": {
        "model": "trafficengine:block/retractable_barrier_end"
      }
    },
    {
      "when": {
        "facing": "east",
        "left_connected": "false",
        "folded": "false"
      },
      "apply": {
        "model": "trafficengine:block/retractable_barrier_end",
        "y": 90
      }
    },
    {
      "when": {
        "facing": "south",
        "right_connected": "false",
        "folded": "false"
      },
      "apply": {
        "model": "trafficengine:block/retractable_barrier_end"
      }
    },
    {
      "when": {
        "facing": "west",
        "right_connected": "false",
        "folded": "false"
      },
      "apply": {
        "model": "trafficengine:block/retractable_barrier_end",
        "y": 90
      }
    },
    {
      "when": {
        "facing": "north|south",
        "folded": "false"
      },
      "apply": {
        "model": "trafficengine:block/retractable_barrier_end",
        "y": 180
      }
    },
    {
      "when": {
        "facing": "east|west",
        "folded": "false"
      },
      "apply": {
        "model": "trafficengine:block/retractable_barrier_end",
        "y": 270
      }
    },
    {
      "when": {
        "facing": "north",
        "folded": "true"
      },
      "apply": {
        "model": "trafficengine:block/retractable_barrier_folded",
        "y": 0
      }
    },
    {
      "when": {
        "facing": "east",
        "folded": "true"
      },
      "apply": {
        "model": "trafficengine:block/retractable_barrier_folded",
        "y": 90
      }
    },
    {
      "when": {
        "facing": "south",
        "folded": "true"
      },
      "apply": {
        "model": "trafficengine:block/retractable_barrier_folded",
        "y": 180
      }
    },
    {
      "when": {
        "facing": "west",
        "folded": "true"
      },
      "apply": {
        "model": "trafficengine:block/retractable_barrier_folded",
        "y": 270
      }
    }
  ]
}
