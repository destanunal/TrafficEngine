{
  "multipart": [
    {
      "when": {
        "base_painted": "false"
      },
      "apply": {
        "model": "trafficengine:block/asphalt"
      }
    },
    {
      "when": {
        "base_painted": "true"
      },
      "apply": {
        "model": "trafficengine:block/asphalt_painted_base"
      }
    },
    {
      "when": {
        "facing": "north"
      },
      "apply": {
        "model": "trafficengine:block/asphalt/21",
        "y": 0
      }
    },
    {
      "when": {
        "facing": "east"
      },
      "apply": {
        "model": "trafficengine:block/asphalt/21",
        "y": 90
      }
    },
    {
      "when": {
        "facing": "south"
      },
      "apply": {
        "model": "trafficengine:block/asphalt/21",
        "y": 180
      }
    },
    {
      "when": {
        "facing": "west"
      },
      "apply": {
        "model": "trafficengine:block/asphalt/21",
        "y": 270
      }
    }
  ]
}