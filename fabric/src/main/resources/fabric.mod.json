{
  "schemaVersion": 1,
  "id": "${modid}",
  "version": "${version}",
  "name": "${display_name}",
  "description": "${description}",
  "authors": [
    "${authors}"
  ],
  "contact": {
    "sources": "https://github.com/"
  },
  "license": "${license}",
  "icon": "${icon}",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.destan.trafficengine.fabric.TrafficEngineFabric"
    ]
  },
  "mixins": [
    "${modid}.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=${fabric_loader_version}",
    "minecraft": "~${minecraft_version}",
    "java": ">=${java_version}",
    "dragonlib": ">=${dragonlib_version}",
    "fabric-api": "*"
  },
  "accessWidener": "${modid}.accesswidener"
}